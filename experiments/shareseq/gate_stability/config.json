{
  "configuration_sources": [
    "evaluation/shareseq_gate_stability/manifests/{all_runs,array_A,array_B,edges}.csv",
    "evaluation/shareseq_gate_stability/preflight.json"
  ],
  "design_size": 192,
  "evaluation_blocker": null,
  "experiment": "share_gate_stability",
  "historical_submission": [
    "evaluation/shareseq_gate_stability/submit.sh",
    "evaluation/shareseq_gate_stability/slurm/array_{a,b}.sbatch"
  ],
  "launch_blocker": "Frozen source hashes and absolute output paths bind the 192-run design to the preserved cluster workspace. Relocation requires a separately validated provenance adapter; do not rerun prepare over the frozen manifest.",
  "resource_wrapper": false,
  "resources": {
    "evaluate": {
      "concurrency": 6,
      "cpus": 8,
      "memory": "64G",
      "time": "24:00:00"
    },
    "train": {
      "concurrency": 6,
      "cpus": 8,
      "gpu": "h100:1",
      "memory": "192G",
      "time": "48:00:00"
    }
  },
  "training": {
    "alt_dim": 100,
    "balance_cutoff": 0.5,
    "balance_power": 4.0,
    "balance_res": 1.0,
    "data_batch_size": 128,
    "dropout": 0.2,
    "hidden_depth": 2,
    "hidden_dim": 256,
    "lam_align": 0.05,
    "lam_graph": 0.02,
    "lr": 0.002,
    "neg_samples": 10,
    "random_sleep": true,
    "require_converge": true,
    "val_split": 0.1
  }
}
